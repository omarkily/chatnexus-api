# Server
PORT=3001
NODE_ENV=development

# MongoDB (local or Atlas) — never commit real credentials
MONGO_URI=mongodb://127.0.0.1:27017/chatnexus

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Frontend origin(s), comma-separated for multiple
CORS_ORIGIN=http://localhost:3000

# Optional master API keys (comma-separated). Leave empty for local JWT-only auth.
MASTER_KEYS=

# Logging: debug | info | warn | error
LOG_LEVEL=debug
